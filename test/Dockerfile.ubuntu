# Stock Ubuntu with NOTHING pre-fixed. python3 is present because Ubuntu ships it;
# python3-venv is deliberately absent, which is Ubuntu's default state.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 curl ca-certificates zsh sudo \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/zsh tester && echo "tester ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/tester
USER tester
WORKDIR /home/tester
ENV SHELL=/bin/zsh
CMD ["/bin/zsh","-l"]
