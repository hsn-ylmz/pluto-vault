#!/bin/bash
# pluto — the single entry point. `pluto TEXT` is a question to Pluto; `pluto` alone opens
# the vault session. A session in the vault reaches every registered project, and Pluto
# decides from the conversation which one a task belongs to. Project names are not
# arguments: a project is created, read and changed inside the conversation.
#
# Deliberately dumb on the launch path: no model call, no network, no classification.
# The launcher is a cd and an exec.
#
# The registry is $PLUTO/projects/*.md — `path:` in each file's frontmatter. The vault
# is the single source of truth; no paths are hardcoded here.
#
# Targets bash 3.2 (what macOS ships): no mapfile, no associative arrays, no ${v^^}.
#
# PLUTO_DRY_RUN=1 makes launch() print where it would go instead of exec'ing the agent.
# Undocumented in --help on purpose: it exists so the dispatch rules can be tested
# without spawning an interactive session.

set -euo pipefail

PLUTO="${PLUTO_HOME:-$HOME/pluto}"
PLUTO_VERSION="1.1.0"

# The agent CLI to hand the question to. Claude Code by default; set PLUTO_AGENT to anything
# else that takes `AGENT [flags] [prompt]`.
AGENT="${PLUTO_AGENT:-claude}"

# registry() — emits name<TAB>path<TAB>status. Shared with .claude/scripts/refresh_active.sh
# so the launcher and the status script can never disagree about what exists.
. "$PLUTO/bin/_pluto_registry.sh"

# ---------------------------------------------------------------------------- helpers

die() { # MSG [EXIT_CODE]
  echo "pluto: $1" >&2
  exit "${2:-1}"
}

# Store paths under $HOME as ~/... so the registry stays portable, matching the
# existing entries. The tilde here is a LITERAL being written into a file, not a
# path being expanded — that is the whole point of the function.
# shellcheck disable=SC2088
tildify() { # ABS_PATH
  case "$1" in
    "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
    "$HOME")   printf '~\n' ;;
    *)         printf '%s\n' "$1" ;;
  esac
}

expand_tilde() { # PATH
  printf '%s\n' "${1/#\~/$HOME}"
}

# Everything after the first non-flag token is ONE question, not a list of agent
# arguments — `claude "why does x fail"` seeds a session, `claude why does x fail`
# is four positionals.
join_args() { # WORD...
  local IFS=' '
  printf '%s\n' "$*"
}

# `exec: claude: not found` is a true statement and a useless one. Check first, and say
# what to do about it.
require_agent() {
  command -v "$AGENT" >/dev/null 2>&1 && return 0
  {
    echo "pluto: '$AGENT' is not on your PATH"
    echo
    echo "pluto hands questions to an agent CLI. Either install that CLI, or point PLUTO_AGENT"
    echo "at the command you use:"
    echo
    echo "    export PLUTO_AGENT=your-agent-command"
    echo
    if [ "$AGENT" = claude ]; then
      echo "Claude Code:  npm install -g @anthropic-ai/claude-code"
      echo "              https://claude.com/claude-code"
      echo
    fi
    echo "Everything that does not start a session still works: --list, --status, --version."
  } >&2
  exit 127
}

# Model tier. Every session starts in the vault and gets the default model. The cheap model
# is opt-in (PLUTO_TIER=quick, or -q for one call). Nothing classifies the question.
# --model is Claude Code's flag, so it is only passed when the agent is Claude Code;
# another PLUTO_AGENT gets its arguments untouched.
model_args() { # -> zero or two lines of agent flags
  local tier="${PLUTO_TIER:-deep}" model=""
  case "$(basename "$AGENT")" in claude) ;; *) return 0 ;; esac

  case "$tier" in
    quick) model="${PLUTO_QUICK_MODEL-haiku}" ;;
    deep)  model="${PLUTO_DEEP_MODEL-}" ;;
  esac
  # Empty means "whatever the agent is already configured to use". Setting
  # PLUTO_QUICK_MODEL= turns the tiering off without editing this file.
  [ -n "$model" ] && printf '%s\n%s\n' --model "$model"
  return 0
}

# Registered project directories that exist on disk, minus the vault itself. Each one is
# reachable from the session through --add-dir, so a question can span projects.
project_dirs() {
  local name dir status
  while IFS=$'\t' read -r name dir status; do
    dir="$(expand_tilde "$dir")"
    [ -d "$dir" ] && [ "$dir" != "$PLUTO" ] && printf '%s\n' "$dir"
  done < <(registry)
  return 0
}

# Start the vault session. The prompt, if any, goes before the --add-dir flags, because
# --add-dir takes several values and would otherwise swallow the prompt.
launch() { # [agent args...]
  [ -d "$PLUTO" ] || die "missing vault: $PLUTO"
  # bash 3.2 has no mapfile, and ${a[@]} on an empty array trips `set -u` there, hence
  # the read loops and the ${a[@]+...} guards.
  local margs=() dirs=() prompt=() a d
  while IFS= read -r a; do margs+=("$a"); done < <(model_args)
  while IFS= read -r d; do dirs+=("$d"); done < <(project_dirs)
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then prompt=("$1"); shift; fi

  if [ -n "${PLUTO_DRY_RUN:-}" ]; then
    printf 'dir: %s\n' "$PLUTO"
    printf 'agent: %s\n' "$AGENT"
    printf 'model: %s\n' "${margs[1]:-<agent default>}"
    printf 'add-dir: %s\n' "${#dirs[@]}"
    exit 0
  fi
  require_agent
  cd "$PLUTO" && exec "$AGENT" ${prompt[@]+"${prompt[@]}"} ${margs[@]+"${margs[@]}"} \
    ${dirs[@]+--add-dir "${dirs[@]}"} ${@+"$@"}
}

# A question. It is announced before the agent starts, so a failure to start reads as
# what it is, not as routing.
ask_launch() { # QUESTION
  [ -n "${PLUTO_DRY_RUN:-}" ] || require_agent
  echo "pluto: asking from $(tildify "$PLUTO"), all registered projects reachable" >&2
  launch "$1"
}

# --------------------------------------------------------------------------- commands

cmd_help() {
  cat <<EOF
pluto — one entry point: ask Pluto anything, or open the vault session.

USAGE
  pluto                        open the vault session
  pluto TEXT...                ask TEXT (Pluto decides which project it belongs to)
  pluto -q TEXT...             the same, on the cheap model for this call

COMMANDS
  -l, --list                   list registered projects and their status
      --status                 git / mtime state of every registered project
  -q, --quick                  cheap model for this call (see MODEL TIER)
      --deep                   default model for this call
  -h, --help                   this text
      --version                print the version

  Anything after a leading '-' that is not a command is forwarded to the agent, so
  'pluto --continue' resumes the last vault session.

MODEL TIER
  Every session starts in the vault on the default model. The cheap model is opt-in:
  PLUTO_TIER=quick, or -q for one call.

  \$PLUTO_QUICK_MODEL defaults to 'haiku'. Set it empty to turn tiering off.
  \$PLUTO_DEEP_MODEL is unset, meaning whatever the agent already uses.
  Only applied when \$PLUTO_AGENT is Claude Code; other agents get their args untouched.

PROJECTS
  Projects are not arguments. A project is created, read and changed inside the
  conversation. The registry is $PLUTO/projects/*.md, one file per project, 'path:' in
  its frontmatter. Every registered project is reachable from the session.

  Your shell splits the words before pluto sees them. With

      alias pluto='noglob pluto'

  in ~/.zshrc, ? and * survive unquoted. Apostrophes and & | ; ( ) < > still do not:

      pluto "what's eating my disk?"

LOCAL COMMANDS
  $PLUTO/bin/pluto-local.sh, if it exists, is sourced before dispatch and can add
  commands of your own. install.sh has no template for it, so it survives every
  re-install.

  Define pluto_local_dispatch (return 0 if you handled the command) and optionally
  pluto_local_commands (one "name:description" per line). pluto's own commands are
  matched first and cannot be shadowed.
$(local_commands | awk -F: 'NF{ printf "      %-24s %s\n", $1, substr($0, index($0,":")+1) }')
$(local_help)
EOF
}

cmd_version() {
  echo "pluto $PLUTO_VERSION"
}

cmd_list() {
  local rows width
  rows="$(registry)"
  [ -n "$rows" ] || die "no entries with a 'path:' in $PLUTO/projects/*.md"

  # Column width from the longest name, so the status column lines up.
  width="$(printf '%s\n' "$rows" | cut -f1 | awk '{ if (length($0) > m) m = length($0) } END { print m }')"

  printf '%s\n' "$rows" | while IFS=$'\t' read -r name dir status; do
    if [ -d "$dir" ]; then
      printf '  %-*s  %s\n' "$width" "$name" "$status"
    else
      # A registry entry pointing nowhere is almost always a typo or a moved
      # directory; say so here.
      printf '  %-*s  %s  [MISSING: %s]\n' "$width" "$name" "$status" "$(tildify "$dir")"
    fi
  done
}

cmd_status() {
  local script="$PLUTO/.claude/scripts/refresh_active.sh"
  [ -x "$script" ] || die "missing or not executable: $script"
  "$script"
}

# ------------------------------------------------------------------------------- local
#
# $PLUTO/bin/pluto-local.sh, when it exists, is sourced here: after every function above is
# defined, so it can use registry(), launch(), die() and the rest, and before dispatch, so
# it can add commands.
#
# install.sh has no template for it and never writes or overwrites it, so whatever you put
# there survives every re-install. That is the point: this file is the seam between the
# tool and the things only you run.
#
# Define one or both:
#   pluto_local_dispatch "$@"   handle a command. Return 0 if you handled it (pluto then
#                               exits), non-zero to let pluto carry on as normal.
#   pluto_local_commands        optional, one "name:description" per line, for --help.
#   pluto_local_help            optional, a full help section printed after that list, for
#                               commands that need more than one line to explain.
#
# pluto's own commands are matched first and cannot be shadowed.
if [ -f "$PLUTO/bin/pluto-local.sh" ]; then
  # shellcheck source=/dev/null
  . "$PLUTO/bin/pluto-local.sh"
fi

local_commands() {
  if type pluto_local_commands >/dev/null 2>&1; then pluto_local_commands; fi
}

local_help() {
  if type pluto_local_help >/dev/null 2>&1; then pluto_local_help; fi
}

# -------------------------------------------------------------------------- dispatch

# Tier flags are consumed first so they can lead a question. They never reach the agent.
while [ $# -gt 0 ]; do
  case "$1" in
    -q|--quick) PLUTO_TIER=quick; shift ;;
    --deep)     PLUTO_TIER=deep;  shift ;;
    *) break ;;
  esac
done
export PLUTO_TIER="${PLUTO_TIER:-}"

case "${1:-}" in
  -h|--help)   cmd_help; exit 0 ;;
  --version)   cmd_version; exit 0 ;;
  -l|--list)   cmd_list; exit 0 ;;
  --status)    cmd_status; exit 0 ;;
esac

# Local commands come after pluto's own, so a local handler cannot shadow --list.
if type pluto_local_dispatch >/dev/null 2>&1 && [ $# -gt 0 ]; then
  if pluto_local_dispatch "$@"; then exit 0; fi
fi

# No arguments: open the vault session. A leading '-' is a flag for the agent (for example
# --continue), not a question. Anything else is one question for Pluto.
if [ $# -eq 0 ]; then
  launch
fi
if [ "${1#-}" != "$1" ]; then
  launch "$@"
fi
ask_launch "$(join_args "$@")"
